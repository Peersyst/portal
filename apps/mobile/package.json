{
    "name": "mobile",
    "private": true,
    "version": "0.0.0",
    "main": "./src/main.ts",
    "scripts": {
        "start": "npx expo start",
        "start:fresh": "pnpm start -c",
        "android": "pnpm start --android",
        "android:fresh": "pnpm start:fresh --android",
        "ios": "pnpm start --ios",
        "ios:fresh": "pnpm start:fresh --ios",
        "web": "pnpm start --web",
        "web:fresh": "pnpm start:fresh --web",
        "test": "jest --maxWorkers=30% --passWithNoTests",
        "test:coverage": "test --coverage --passWithNoTests",
        "test:watch": "test --watch --passWithNoTests",
        "test:debug": "jest --no-cache --runInBand --passWithNoTests",
        "test:ci": "jest --runInBand",
        "clean": "rimraf .cache .expo .turbo node_modules",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit",
        "prebuild": "npx expo prebuild",
        "generate": "npm run generate:icons && npm run generate:images",
        "generate:icons": "node script/icon-generator-native.js ./src/assets/icons/ ./src/common/icons/ && prettier --write ./src/common/icons/",
        "generate:images": "node script/images-generator.js ./src/assets/images/"
    },
    "dependencies": {
        "@aws-sdk/client-appconfigdata": "^3.556.0",
        "@babel/runtime": "^7.24.8",
        "@frontend/config": "workspace:*",
        "@frontend/core": "workspace:*",
        "@frontend/events": "workspace:*",
        "@frontend/locale": "workspace:*",
        "@frontend/query": "workspace:*",
        "@frontend/settings": "workspace:*",
        "@peersyst/react-hooks": "^2.2.15",
        "@peersyst/react-native-components": "^3.6.0",
        "@peersyst/react-native-styled": "^3.3.0",
        "@peersyst/react-native-utils": "^2.2.0",
        "@peersyst/react-utils": "^2.5.0",
        "@react-native-async-storage/async-storage": "1.24.0",
        "@react-native-community/hooks": "^3.0.0",
        "@react-native-community/netinfo": "11.3.2",
        "@react-navigation/native": "^6.1.18",
        "@react-navigation/native-stack": "^6.11.0",
        "@shared/api": "workspace:*",
        "@shared/utils": "workspace:*",
        "@tanstack/query-async-storage-persister": "^5.51.17",
        "@tanstack/react-query": "^5.52.2",
        "@tanstack/react-query-persist-client": "^5.51.18",
        "bignumber.js": "^9.1.2",
        "buffer": "^6.0.3",
        "core-js": "^3.37.1",
        "create-hash": "^1.2.0",
        "events": "^3.3.0",
        "expo": "^50.0.17",
        "expo-asset": "~9.0.2",
        "expo-constants": "~15.4.6",
        "expo-crypto": "~12.8.1",
        "expo-font": "~11.10.3",
        "expo-linking": "~6.2.2",
        "expo-localization": "~14.8.4",
        "expo-secure-store": "~12.8.1",
        "expo-splash-screen": "~0.26.5",
        "expo-status-bar": "~1.11.1",
        "https-browserify": "^1.0.0",
        "i18next": "^23.12.2",
        "metro-cache": "^0.80.10",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-i18next": "^15.0.0",
        "react-native": "0.73.6",
        "react-native-gesture-handler": "~2.18.1",
        "react-native-keyboard-aware-scroll-view": "^0.9.5",
        "react-native-safe-area-context": "4.8.2",
        "react-native-screens": "~3.29.0",
        "react-native-svg": "14.1.0",
        "stable-hash": "^0.0.4",
        "stream-browserify": "^3.0.0",
        "stream-http": "^3.2.0",
        "text-encoding": "^0.7.0",
        "url": "^0.11.4",
        "zustand": "^5.0.0-rc.0"
    },
    "devDependencies": {
        "@babel/core": "^7.24.4",
        "@expo/config": "^9.0.3",
        "@react-navigation/drawer": "^6.7.2",
        "@shared/eslint": "workspace:*",
        "@shared/test": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@swisstype/essential": "^0.1.1",
        "@testing-library/jest-native": "^5.4.3",
        "@testing-library/react-native": "^12.0.0",
        "@types/jest": "^29.5.12",
        "@types/node": "latest",
        "@types/react": "^18.3.4",
        "@types/react-native": "~0.71.5",
        "babel-plugin-module-resolver": "^5.0.0",
        "babel-plugin-transform-inline-environment-variables": "^0.4.4",
        "babel-plugin-transform-remove-console": "^6.9.4",
        "jest": "^29.7.0",
        "jest-expo": "~50.0.4",
        "react-test-renderer": "18.2.0",
        "ts-jest": "^29.1.2",
        "typescript": "latest"
    }
}

{
    "name": "mobile",
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "bootstrap": "yarn install",
        "clean": "rm -rf node_modules",
        "start": "yarn generate && expo start",
        "start:fresh": "yarn start -c",
        "android": "yarn start --android",
        "android:fresh": "yarn start:fresh --android",
        "ios": "yarn start --ios",
        "ios:fresh": "yarn start:fresh --ios",
        "web": "yarn start --web",
        "web:fresh": "yarn start:fresh --web",
        "generate": "npm run generate:icons && npm run generate:images",
        "generate:icons": "node script/iconGeneratorNative.js ./src/ui/assets/icons/ ./src/ui/common/icons/ && prettier --write ./src/ui/common/icons/",
        "generate:images": "node script/imagesGenerator.js ./src/ui/assets/images/",
        "prebuild": "npx expo prebuild",
        "test": "jest --maxWorkers=30%",
        "test:ui": "yarn test ./test/ui",
        "test:domain": "yarn test ./test/domain",
        "test:data-access": "yarn test ./test/data-access",
        "test:coverage": "yarn test --coverage",
        "test:coverage:ui": "yarn test:ui --coverage",
        "test:coverage:domain": "yarn test:domain --coverage",
        "test:coverage:data-access": "yarn test:data-access --coverage",
        "test:watch": "yarn test --watch",
        "test:watch:ui": "yarn test:ui --watch",
        "test:watch:domain": "yarn test:domain --watch",
        "test:watch:data-access": "yarn test:data-access --watch",
        "test:debug": "jest --no-cache --runInBand",
        "test:debug:ui": "jest ./test/ui --no-cache --runInBand",
        "test:debug:domain": "jest ./test/domain --no-cache --runInBand",
        "test:debug:data-access": "jest ./test/data-access --no-cache --runInBand",
        "test:ci": "jest --runInBand",
        "check-types": "tsc --noemit",
        "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.json --max-warnings 0 && yarn check-types",
        "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.json --max-warnings 0 --fix && yarn check-types",
        "playground:start": "yarn generate:icons && yarn --cwd ./playground start",
        "playground:android": "yarn playground:start --android",
        "playground:ios": "yarn playground:start --ios"
    },
    "dependencies": {
        "@aws-sdk/client-appconfigdata": "^3.556.0",
        "@peersyst/apis": "file:../../packages/apis",
        "@peersyst/common": "file:../../packages/common",
        "@peersyst/config": "file:../../packages/config",
        "@peersyst/domain": "file:../../packages/domain",
        "@peersyst/env": "file:../../packages/env",
        "@peersyst/events": "file:../../packages/events",
        "@peersyst/locale": "file:../../packages/locale",
        "@peersyst/react-hooks": "^2.2.15",
        "@peersyst/react-native-components": "^3.6.0",
        "@peersyst/react-native-styled": "^3.3.0",
        "@peersyst/react-native-utils": "^2.2.0",
        "@peersyst/react-utils": "^2.5.0",
        "@peersyst/ui": "file:../../packages/ui",
        "@react-native-async-storage/async-storage": "1.21.0",
        "@react-native-community/hooks": "^3.0.0",
        "@react-native-community/netinfo": "11.1.0",
        "@react-navigation/native": "^6.1.6",
        "@react-navigation/native-stack": "^6.5.0",
        "@tanstack/query-async-storage-persister": "^5.32.0",
        "@tanstack/react-query": "^5.51.18",
        "@tanstack/react-query-persist-client": "^5.32.0",
        "bignumber.js": "^9.1.2",
        "core-js": "^3.37.1",
        "create-hash": "^1.2.0",
        "events": "^3.3.0",
        "expo": "^50.0.17",
        "expo-asset": "~9.0.2",
        "expo-constants": "~15.4.6",
        "expo-crypto": "~12.8.1",
        "expo-font": "~11.10.3",
        "expo-linking": "~6.2.2",
        "expo-localization": "~14.8.4",
        "expo-secure-store": "~12.8.1",
        "expo-splash-screen": "~0.26.5",
        "expo-status-bar": "~1.11.1",
        "https-browserify": "^1.0.0",
        "i18next": "^23.12.2",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-i18next": "^14.1.1",
        "react-native": "0.73.6",
        "react-native-gesture-handler": "~2.14.0",
        "react-native-keyboard-aware-scroll-view": "^0.9.5",
        "react-native-safe-area-context": "4.8.2",
        "react-native-screens": "~3.29.0",
        "react-native-svg": "14.1.0",
        "stable-hash": "^0.0.4",
        "stream-browserify": "^3.0.0",
        "stream-http": "^3.2.0",
        "text-encoding": "^0.7.0",
        "url": "^0.11.4",
        "zustand": "^4.3.6"
    },
    "devDependencies": {
        "@babel/core": "^7.24.4",
        "@peersyst/eslint": "file:../../packages/eslint",
        "@peersyst/test-utils": "file:../../packages/test-utils",
        "@react-navigation/drawer": "^6.7.2",
        "@testing-library/jest-native": "^5.4.3",
        "@testing-library/react-native": "^12.0.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^18.15.5",
        "@types/react": "~18.2.79",
        "@types/react-native": "~0.71.5",
        "@typescript-eslint/eslint-plugin": "^5.56.0",
        "@typescript-eslint/parser": "^5.56.0",
        "babel-plugin-module-resolver": "^5.0.0",
        "babel-plugin-transform-inline-environment-variables": "^0.4.4",
        "babel-plugin-transform-remove-console": "^6.9.4",
        "eslint": "^8.36.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-plugin-prettier": "^4.2.1",
        "eslint-plugin-react": "^7.32.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "jest": "^29.7.0",
        "jest-expo": "~50.0.4",
        "openapi-typescript": "^6.2.0",
        "openapi-typescript-codegen": "^0.23.0",
        "prettier": "^2.8.6",
        "react-test-renderer": "18.2.0",
        "ts-jest": "^29.1.2",
        "typescript": "^5.4.5"
    },
    "resolutions": {
        "react-native-safe-area-context": "4.8.2",
        "react-native-svg": "14.1.0"
    }
}

{
    "name": "api",
    "version": "0.0.0",
    "description": "Base backend API",
    "author": "Peersyst",
    "private": true,
    "scripts": {
        "bootstrap": "yarn install",
        "clean": "rimraf dist coverage node_modules",
        "prebuild": "rimraf dist",
        "build": "nest build",
        "start": "nest start --watch",
        "test": "jest --coverage --maxWorkers=30%",
        "test:unit": "jest --watch",
        "test:e2e": "jest --config ./test/jest-e2e.json --coverage",
        "lint": "eslint . --ext .ts,.json --max-warnings=0",
        "db:seed": "env-cmd --silent ts-node src/seeds/cmd/seed.ts",
        "db:pack": "env-cmd --silent ts-node src/seeds/cmd/pack.ts"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.ts$": "ts-jest"
        },
        "collectCoverageFrom": [
            "./src/modules/**/*.ts",
            "!./src/modules/**/*.controller.ts",
            "!./src/modules/**/*.request.ts",
            "!./src/modules/**/*.dto.ts",
            "!./src/modules/auth/guards/**/*.ts",
            "!./src/modules/auth/strategies/**/*.ts",
            "!./src/modules/auth/auth.decorator.ts",
            "!./src/modules/common/exception/**/*.ts",
            "!./src/modules/**/*.module.ts"
        ],
        "coverageDirectory": "./coverage",
        "testEnvironment": "node",
        "coverageThreshold": {
            "global": {
                "branches": 90,
                "statements": 90
            }
        }
    },
    "dependencies": {
        "@aws-sdk/client-secrets-manager": "^3.266.1",
        "@nanogiants/nestjs-swagger-api-exception-decorator": "^1.6.5",
        "@nestjs/cli": "^10.3.0",
        "@nestjs/common": "^10.3.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.3.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.2",
        "@nestjs/platform-express": "^10.2.10",
        "@nestjs/swagger": "~7.1.16",
        "@nestjs/typeorm": "^10.0.1",
        "@peersyst/auth-module": "^0.12.73",
        "@peersyst/api-utils": "file:../../packages/api-utils",
        "@peersyst/common": "../../packages/common",
        "@peersyst/database": "file:../../packages/database",
        "@peersyst/env-config": "file:../../packages/env-config",
        "@peersyst/test-utils": "file:../../packages/test-utils",
        "bcrypt": "^5.1.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.0",
        "cross-env": "^7.0.3",
        "env-cmd": "^10.1.0",
        "express-openapi-validator": "^5.0.1",
        "helmet": "^6.0.1",
        "morgan": "^1.10.0",
        "nest-winston": "^1.8.0",
        "nestjs-command": "^3.1.3",
        "object-mapper": "^6.2.0",
        "passport": "0.6.0",
        "passport-jwt": "4.0.1",
        "passport-local": "1.0.0",
        "pg": "^8.9.0",
        "reflect-metadata": "0.1.13",
        "rimraf": "4.1.2",
        "rxjs": "^7.8.0",
        "swagger-ui-express": "4.6.0",
        "typeorm": "^0.3.12",
        "winston": "^3.8.2",
        "yargs": "^17.6.2"
    },
    "devDependencies": {
        "@peersyst/eslint": "file:../../packages/eslint",
        "@nestjs/schematics": "^10.0.3",
        "@nestjs/testing": "^10.2.10",
        "@types/bcrypt": "^5.0.0",
        "@types/express": "4.17.17",
        "@types/jest": "^29.4.0",
        "@types/morgan": "^1.9.4",
        "@types/node": "18.13.0",
        "@types/object-mapper": "^6.2.0",
        "@types/random-seed": "^0.3.3",
        "@types/supertest": "2.0.12",
        "@types/ws": "8.5.4",
        "@types/yargs": "^17.0.22",
        "eslint": "^8.33.0",
        "jest": "29.4.2",
        "nock": "^13.3.0",
        "supertest": "6.3.3",
        "ts-jest": "29.0.5",
        "ts-loader": "9.4.2",
        "ts-node": "10.9.1",
        "tsconfig-paths": "4.1.2",
        "typeorm-model-generator": "^0.4.6",
        "typescript": "4.9.5"
    }
}

{
    "name": "web",
    "private": true,
    "version": "0.0.0",
    "scripts": {
        "start": "vite",
        "build": "tsc -b && vite build",
        "bootstrap": "yarn install",
        "generate": "npm run generate:icons && npm run generate:images",
        "generate:icons": "node script/iconGenerator.js src/ui/assets/icons/ src/ui/common/icons/",
        "generate:images": "node script/imagesGenerator.js src/ui/assets/images/",
        "test": "jest --maxWorkers=30%",
        "test:ui": "yarn test ./test/ui",
        "test:data-access": "yarn test ./test/data-access",
        "test:coverage": "yarn test --coverage",
        "test:coverage:ui": "yarn test:ui --coverage",
        "test:coverage:domain": "yarn test:domain --coverage",
        "test:coverage:data-access": "yarn test:data-access --coverage",
        "test:watch": "yarn test --watch",
        "test:watch:ui": "yarn test:ui --watch",
        "test:watch:domain": "yarn test:domain --watch",
        "test:watch:data-access": "yarn test:data-access --watch",
        "test:debug": "jest --no-cache --runInBand",
        "test:debug:ui": "jest ./test/ui --no-cache --runInBand",
        "test:debug:domain": "jest ./test/domain --no-cache --runInBand",
        "test:debug:data-access": "jest ./test/data-access --no-cache --runInBand",
        "test:ci": "jest --runInBand",
        "check-types": "tsc --noemit",
        "lint": "eslint . --ext .ts,.json --max-warnings=0 && yarn check-types",
        "lint:fix": "eslint . --ext .ts,.json --max-warnings=0 --fix && yarn check-types",
        "preview": "vite preview",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@peersyst/apis": "file:../../packages/apis",
        "@peersyst/common": "file:../../packages/common",
        "@peersyst/config": "file:../../packages/config",
        "@peersyst/domain": "file:../../packages/domain",
        "@peersyst/env": "file:../../packages/env",
        "@peersyst/events": "file:../../packages/events",
        "@peersyst/locale": "file:../../packages/locale",
        "@peersyst/react-components": "^3.9.34",
        "@peersyst/react-hooks": "^2.2.15",
        "@peersyst/react-utils": "^2.5.0",
        "@peersyst/ui": "file:../../packages/ui",
        "@tanstack/query-sync-storage-persister": "^5.51.15",
        "@tanstack/react-query": "^5.51.15",
        "@tanstack/react-query-persist-client": "^5.51.15",
        "buffer": "^6.0.3",
        "events": "^3.3.0",
        "init": "^0.1.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.25.1",
        "styled-components": "^5.3.6"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^1.6.1",
        "@peersyst/eslint": "file:../../packages/eslint",
        "@peersyst/test-utils": "file:../../packages/test-utils",
        "@storybook/addon-essentials": "^8.2.6",
        "@storybook/addon-interactions": "^8.2.6",
        "@storybook/addon-links": "^8.2.6",
        "@storybook/addon-onboarding": "^8.2.6",
        "@storybook/blocks": "^8.2.6",
        "@storybook/builder-vite": "^8.2.6",
        "@storybook/react": "^8.2.6",
        "@storybook/react-vite": "^8.2.6",
        "@storybook/test": "^8.2.6",
        "@testing-library/jest-dom": "^6.4.8",
        "@types/events": "^3.0.3",
        "@types/jest": "^29.5.12",
        "@types/node": "^22.0.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/styled-components": "^5.1.34",
        "@typescript-eslint/eslint-plugin": "^7.15.0",
        "@typescript-eslint/parser": "^7.15.0",
        "@vitejs/plugin-react": "^4.3.1",
        "babel-jest": "^29.7.0",
        "eslint": "^8.57.0",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-refresh": "^0.4.7",
        "eslint-plugin-storybook": "^0.8.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "storybook": "^8.2.6",
        "ts-jest": "^29.2.3",
        "typescript": "^5.2.2",
        "vite": "^5.3.5",
        "vite-tsconfig-paths": "^4.3.2"
    }
}

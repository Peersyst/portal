{
    "name": "web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "preview": "vite preview",
        "generate": "npm run generate:icons && npm run generate:images",
        "generate:icons": "node script/iconGenerator.cjs src/ui/assets/icons/ src/ui/common/icons/",
        "generate:images": "node script/imagesGenerator.cjs src/ui/assets/images/",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --maxWorkers=30%",
        "test:coverage": "yarn test --coverage",
        "test:watch": "yarn test --watch",
        "test:debug": "jest --no-cache --runInBand",
        "test:ci": "jest --runInBand",
        "check-types": "tsc --noemit",
        "lint": "eslint . --ext .ts,.json --max-warnings=0 && yarn check-types",
        "lint:fix": "eslint . --ext .ts,.json --max-warnings=0 --fix && yarn check-types"
    },
    "dependencies": {
        "@frontend/config": "workspace:*",
        "@frontend/core": "workspace:*",
        "@frontend/design-system-core": "workspace:*",
        "@frontend/events": "workspace:*",
        "@frontend/locale": "workspace:*",
        "@frontend/settings": "workspace:*",
        "@peersyst/react-components": "^3.9.34",
        "@peersyst/react-hooks": "^2.2.15",
        "@peersyst/react-utils": "^2.5.0",
        "@shared/api": "workspace:*",
        "@shared/env": "workspace:*",
        "@shared/string": "workspace:*",
        "@shared/utils": "workspace:*",
        "@tanstack/query-sync-storage-persister": "^5.51.15",
        "@tanstack/react-query": "^5.51.15",
        "@tanstack/react-query-persist-client": "^5.51.15",
        "@aws-sdk/client-appconfigdata": "^3.556.0",
        "bignumber.js": "^9.1.2",
        "buffer": "^6.0.3",
        "clsx": "^2.1.1",
        "events": "^3.3.0",
        "i18next": "^23.11.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-i18next": "^14.1.1",
        "react-router-dom": "^6.26.0",
        "styled-components": "^5.3.6",
        "vite-plugin-node-polyfills": "^0.22.0",
        "zustand": "^4.3.6"
    },
    "devDependencies": {
        "@jest/globals": "^29.7.0",
        "@shared/eslint": "workspace:*",
        "@shared/test": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@swisstype/essential": "^0.1.1",
        "@testing-library/jest-dom": "^6.4.8",
        "@types/events": "^3.0.3",
        "@types/jest": "^29.5.12",
        "@types/node": "^22.0.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/styled-components": "^5.1.34",
        "@vitejs/plugin-react": "^4.3.1",
        "babel-jest": "^29.7.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "ts-jest": "^29.2.3",
        "typescript": "latest",
        "vite": "^5.4.0",
        "vite-tsconfig-paths": "^5.0.1"
    }
}

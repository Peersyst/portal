    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "clean": "rimraf .turbo dist node_modules",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit"
    },
    "exports": {
        "./palette": {
            "types": "./dist/palette/index.d.ts",
            "require": "./dist/palette/index.js",
            "import": "./dist/palette/index.mjs"
        },
        "./typography": {
            "types": "./dist/typography/index.d.ts",
            "require": "./dist/typography/index.js",
            "import": "./dist/typography/index.mjs"
        },
        "./themes": {
            "types": "./dist/themes/index.d.ts",
            "require": "./dist/themes/index.js",
            "import": "./dist/themes/index.mjs"
        },
        "./themes/default": {
            "types": "./dist/themes/default/index.d.ts",
            "require": "./dist/themes/default/index.js",
            "import": "./dist/themes/default/index.mjs"
        }
    },
    "peerDependencies": {
        "@frontend/locale": "workspace:*",
        "@peersyst/react-components-core": "^1.7.19",
        "@peersyst/react-utils": "^2.5.0",
        "@shared/string": "workspace:*",
        "i18next": "^23.14.0"
    },
    "devDependencies": {
        "@frontend/locale": "workspace:*",
        "@peersyst/react-components-core": "^1.7.19",
        "@peersyst/react-utils": "^2.5.0",
        "@shared/eslint": "workspace:*",

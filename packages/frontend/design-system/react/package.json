{
    "name": "@frontend/design-system-react",
    "author": "Peersyst",
    "version": "0.0.0",
    "license": "UNLICENSED",
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "storybook": "storybook dev -p 6006 -c storybook",
        "generate:icons": "node scripts/icon-generator.js src/assets/icons/ src/components/icons/",
        "lint": "eslint ."
    },
    "exports": {
        ".": {
            "require": "./dist/core/index.js",
            "import": "./dist/core/index.mjs",
            "types": "./dist/core/index.d.ts"
        },
        "./config": {
            "require": "./dist/config/index.js",
            "import": "./dist/config/index.mjs",
            "types": "./dist/config/index.d.ts"
        },
        "./themes": {
            "require": "./dist/themes/index.js",
            "import": "./dist/themes/index.mjs",
            "types": "./dist/themes/index.d.ts"
        },
        "./theme/types": {
            "require": "./dist/themes/common/theme.types.js",
            "import": "./dist/themes/common/theme.types.mjs",
            "types": "./dist/themes/common/theme.types.d.ts"
        },
        "./styles/types": {
            "require": "./dist/styles/styles.types.js",
            "import": "./dist/styles/styles.types.mjs",
            "types": "./dist/styles/styles.types.d.ts"
        },
        "./styles/fonts": "./dist/styles/fonts.css",
        "./styles/global-styles": {
            "require": "./dist/styles/global-styles.js",
            "import": "./dist/styles/global-styles.mjs",
            "types": "./dist/styles/global-styles.d.ts"
        },
        "./icons": {
            "require": "./dist/components/icons/index.js",
            "import": "./dist/components/icons/index.mjs",
            "types": "./dist/components/icons/index.d.ts"
        },
        "./button": {
            "require": "./dist/components/button/index.js",
            "import": "./dist/components/button/index.mjs",
            "types": "./dist/components/button/index.d.ts"
        }
    },
    "dependencies": {
        "@peersyst/react-components": "^3.9.35"
    },
    "peerDependencies": {
        "@frontend/config": "workspace:*",
        "@frontend/design-system-core": "workspace:*",
        "@frontend/locale": "workspace:*",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "styled-components": "^5.3.6"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^1.6.1",
        "@frontend/config": "workspace:*",
        "@frontend/design-system-core": "workspace:*",
        "@frontend/locale": "workspace:*",
        "@shared/eslint": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@storybook/addon-essentials": "^8.2.9",
        "@storybook/addon-interactions": "^8.2.9",
        "@storybook/addon-links": "^8.2.9",
        "@storybook/addon-onboarding": "^8.2.9",
        "@storybook/blocks": "^8.2.9",
        "@storybook/react": "^8.2.9",
        "@storybook/react-vite": "^8.2.9",
        "@storybook/test": "^8.2.9",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/styled-components": "^5.1.34",
        "@vitejs/plugin-react": "^4.3.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "storybook": "^8.2.9",
        "styled-components": "^5.3.6",
        "typescript": "latest"
    }
}

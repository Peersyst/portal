{
    "name": "frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "prebuild": "rimraf build",
        "start": "npm run generate && craco start",
        "build": "craco build",
        "eject": "craco eject",
        "generate": "npm run generate:openapi && npm run generate:icons && npm run generate:images",
        "generate:icons": "node script/iconGenerator.js src/ui/assets/icons/ src/ui/common/icons/",
        "generate:images": "node script/imagesGenerator.js src/ui/assets/images/",
        "generate:openapi": "openapi -i ../backend/openapi-spec.json -o src/data-access/api/service --exportSchemas=true --useUnionTypes --postfix=Api",
        "test": "jest --maxWorkers=30%",
        "test:ui": "yarn test --projects ./test/ui",
        "test:domain": "yarn test --projects ./test/domain",
        "test:data-access": "yarn test --projects ./test/data-access",
        "test:coverage": "yarn test --coverage",
        "test:watch": "yarn test --watch",
        "test:watch:ui": "yarn test:watch --projects ./test/ui",
        "test:watch:domain": "yarn test:watch --projects ./test/domain",
        "test:watch:data-access": "yarn test:watch --projects ./test/data-access",
        "test:debug": "jest --coverage --no-cache --runInBand",
        "test:debug:ui": "yarn test:debug --projects ./test/ui",
        "test:debug:domain": "yarn test:debug --projects ./test/domain",
        "test:debug:data-access": "yarn test:debug --projects ./test/data-access",
        "test:ci": "jest --runInBand --coverage ./test",
        "lint": "eslint . --ext .ts,.json --max-warnings=0"
    },
    "dependencies": {
        "@craco/craco": "^7.0.0",
        "@peersyst/react-components": "^3.2.1",
        "@peersyst/react-hooks": "^2.2.0",
        "@peersyst/react-types": "^1.3.4",
        "@peersyst/react-utils": "^2.1.0",
        "babel-plugin-styled-components": "^2.0.7",
        "i18next": "^22.4.9",
        "i18next-browser-languagedetector": "^7.0.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-i18next": "^12.1.5",
        "react-query": "^3.34.12",
        "react-router-dom": "6.8.0",
        "react-scripts": "^5.0.1",
        "styled-components": "^5.3.6",
        "typescript": "^4.7.4",
        "web-vitals": "^3.1.1",
        "zustand": "^4.3.2"
    },
    "devDependencies": {
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/plugin-proposal-decorators": "^7.18.6",
        "@babel/plugin-transform-runtime": "7.19.6",
        "@babel/preset-env": "^7.18.6",
        "@babel/preset-react": "^7.18.6",
        "@babel/preset-typescript": "7.18.6",
        "@cypress/code-coverage": "3.10.0",
        "@cypress/instrument-cra": "^1.4.0",
        "@testing-library/cypress": "9.0.0",
        "@testing-library/dom": "8.20.0",
        "@testing-library/jest-dom": "^5.14.1",
        "@testing-library/react": "^13.4.0",
        "@testing-library/user-event": "^14.4.3",
        "@types/jest": "^29.4.0",
        "@types/node": "^18.0.1",
        "@types/react": "^18.0.27",
        "@types/react-dom": "^18.0.10",
        "@types/react-router-dom": "^5.3.2",
        "@types/styled-components": "^5.1.20",
        "babel-jest": "^29.4.1",
        "customize-cra": "^1.0.0",
        "customize-cra-react-refresh": "^1.1.0",
        "eslint": "^8.33.0",
        "eslint-config-prettier": "8.6.0",
        "eslint-config-react": "^1.1.7",
        "eslint-plugin-cypress": "^2.12.1",
        "eslint-plugin-import": "2.27.5",
        "eslint-plugin-prettier": "4.2.1",
        "eslint-plugin-react": "^7.30.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "29.4.1",
        "jest-environment-jsdom": "^29.4.1",
        "openapi-typescript": "^6.1.0",
        "openapi-typescript-codegen": "^0.23.0",
        "prettier": "^2.8.3",
        "react-error-overlay": "6.0.11",
        "ts-jest": "^29.0.5"
    },
    "resolutions": {
        "@types/react": "^18.0.27"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}

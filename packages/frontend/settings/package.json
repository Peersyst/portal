{
    "name": "@frontend/settings",
    "author": "Peersyst",
    "version": "0.0.0",
    "license": "UNLICENSED",
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "test": "jest --maxWorkers=30%",
        "test:coverage": "test --coverage",
        "test:watch": "test --watch",
        "test:debug": "jest --no-cache --runInBand",
        "clean": "rimraf .turbo dist node_modules",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit"
    },
    "exports": {
        ".": {
            "types": "./dist/common/index.d.ts",
            "require": "./dist/common/index.js",
            "import": "./dist/common/index.mjs"
        },
        "./data-access/services/browser": {
            "types": "./dist/data-access/services/browser/index.d.ts",
            "require": "./dist/data-access/services/browser/index.js",
            "import": "./dist/data-access/services/browser/index.mjs"
        },
        "./data-access/services/react-native": {
            "types": "./dist/data-access/services/react-native/index.d.ts",
            "require": "./dist/data-access/services/react-native/index.js",
            "import": "./dist/data-access/services/react-native/index.mjs"
        },
        "./data-access/repositories": {
            "types": "./dist/data-access/repositories/index.d.ts",
            "require": "./dist/data-access/repositories/index.js",
            "import": "./dist/data-access/repositories/index.mjs"
        },
        "./domain/controllers": {
            "types": "./dist/domain/controllers/index.d.ts",
            "require": "./dist/domain/controllers/index.js",
            "import": "./dist/domain/controllers/index.mjs"
        },

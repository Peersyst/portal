        },
        "./domain/events": {
            "types": "./dist/domain/settings.events.d.ts",
            "require": "./dist/domain/settings.events.js",
            "import": "./dist/domain/settings.events.mjs"
        },
        "./domain/state": {
            "types": "./dist/domain/settings.state.d.ts",
            "require": "./dist/domain/settings.state.js",
            "import": "./dist/domain/settings.state.mjs"
        },
        "./domain/interfaces": {
            "types": "./dist/domain/interfaces/index.d.ts",
            "require": "./dist/domain/interfaces/index.js",
            "import": "./dist/domain/interfaces/index.mjs"

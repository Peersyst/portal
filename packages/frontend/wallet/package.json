        "./providers/xrp/xrpl/xrpl-faucet/repositories": {
            "types": "./dist/providers/xrp/xrpl/xrpl-faucet/repositories/index.d.ts",
            "require": "./dist/providers/xrp/xrpl/xrpl-faucet/repositories/index.js",
            "import": "./dist/providers/xrp/xrpl/xrpl-faucet/repositories/index.mjs"
        }

            "import": "./dist/providers/xrp/xrpl/xrpl-faucet/index.mjs"
        },
        "./providers/xrp/xrpl/xrpl-faucet/interfaces": {
            "types": "./dist/providers/xrp/xrpl/xrpl-faucet/interfaces/index.d.ts",

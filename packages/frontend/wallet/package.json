{
    "name": "@frontend/wallet",
    "author": "Peersyst",
    "version": "0.0.0",
    "license": "UNLICENSED",
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "test": "jest --maxWorkers=30% --passWithNoTests",
        "test:coverage": "test --coverage --passWithNoTests",
        "test:watch": "test --watch --passWithNoTests",
        "test:debug": "jest --no-cache --runInBand --passWithNoTests",
        "clean": "rimraf .turbo dist node_modules",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.mjs"
        },
        "./providers": {
            "types": "./dist/providers/index.d.ts",
            "require": "./dist/providers/index.js",
            "import": "./dist/providers/index.mjs"
        },
        "./providers/error": {
            "types": "./dist/providers/core/error/index.d.ts",
            "require": "./dist/providers/core/error/index.js",
            "import": "./dist/providers/core/error/index.mjs"
        },
        "./providers/interfaces": {
            "types": "./dist/providers/core/interfaces/index.d.ts",
            "require": "./dist/providers/core/interfaces/index.js",
            "import": "./dist/providers/core/interfaces/index.mjs"
        },
        "./providers/evm": {
            "types": "./dist/providers/evm/index.d.ts",
            "require": "./dist/providers/evm/index.js",
            "import": "./dist/providers/evm/index.mjs"
        },

{
    "name": "@database/api",
    "author": "Peersyst",
    "version": "0.0.0",
    "license": "UNLICENSED",
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "clean": "rimraf .turbo dist node_modules",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit",
        "bundle": "genesys bundle",
        "typeorm": "typeorm-ts-node-commonjs -d ./dist/data-source.js",
        "db:migration:create": "pnpm run typeorm migration:create",
        "db:migration:generate": "pnpm run typeorm migration:generate",
        "db:migration:run": "pnpm run typeorm migration:run",
        "db:migration:revert": "pnpm run typeorm migration:revert",
        "db:schema:drop": "pnpm run typeorm schema:drop"
    },
    "exports": {
        "./config": "./src/config.ts",
        "./data-source": "./src/data-source.ts",
        "./entities": "./src/entities/index.ts",
        "./seed/seeder": "./src/seed/seeder.ts",
        "./seed/seeds": "./src/seed/seeds/index.ts"
    },
    "peerDependencies": {
        "@backend/config": "workspace:*",
        "@database/seed": "workspace:*",
        "@nestjs/config": "^3.1.1",
        "@peersyst/auth-module": "^0.14.6",
        "passport-jwt": "4.0.1",
        "typeorm": "^0.3.0"
    },
    "devDependencies": {
        "@backend/config": "workspace:*",
        "@database/seed": "workspace:*",
        "@nestjs/config": "^3.1.1",
        "@peersyst/auth-module": "^0.14.6",
        "@shared/eslint": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@shared/tsup": "workspace:*",
        "@types/node": "latest",
        "passport-jwt": "4.0.1",
        "ts-node": "10.9.2",
        "typeorm": "^0.3.0",
        "typescript": "latest"
    }
}

{
    "name": "@peersyst/database",
    "version": "1.0.0",
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "license": "MIT",
    "scripts": {
        "clean": "rm -rf dist node_modules",
        "build": "tsc && rm -rf ./node_modules/@peersyst",
        "lint": "eslint . --ext .ts,.json --max-warnings=0",
        "typeorm": "ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js -d src/cmd/database.config.ts",
        "db:migration:create": "npm run typeorm -- migration:create",
        "db:migration:generate": "npm run typeorm -- migration:generate",
        "db:migration:run": "npm run typeorm migration:run",
        "db:migration:revert": "npm run typeorm migration:revert",
        "db:schema:drop": "npm run typeorm -- schema:drop",
        "db:entities:generate": "typeorm-model-generator -h localhost -d db_database -u db_user -x db_password -e mysql -o ./src/database"
    },
    "peerDependencies": {
        "@peersyst/common": "*",
        "@peersyst/env-config": "*",
        "@nestjs/common": "^10.3.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.3.0",
        "@nestjs/typeorm": "^10.0.1",
        "@peersyst/auth-module": "^0.14.3",
        "@peersyst/kyc-module": "^0.13.8",
        "bcrypt": "^5.1.1",
        "pg": "^8.11.3",
        "reflect-metadata": "^0.1.13",
        "typeorm": "^0.3.0"
    },
    "devDependencies": {
        "@peersyst/common": "file:../common",
        "@peersyst/env-config": "file:../env-config",
        "@peersyst/eslint": "file:../eslint",
        "@nestjs/common": "^10.3.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.3.0",
        "@nestjs/typeorm": "^10.0.1",
        "@peersyst/auth-module": "^0.14.3",
        "@peersyst/kyc-module": "0.13.8",
        "@types/node": "^20.10.6",
        "bcrypt": "^5.1.1",
        "pg": "^8.11.3",
        "eslint": "^8.33.0",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.2.0",
        "ts-node": "^10.9.2",
        "typeorm": "0.3.17",
        "typescript": "^5.3.2"
    }
}

{
    "name": "@shared/api",
    "author": "Peersyst",
    "version": "0.0.0",
    "license": "UNLICENSED",
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "generate": "openapi -i ../../../apps/api/openapi-spec.json -o src --exportSchemas=true --exportModels=true --useUnionTypes --postfixServices=Api"
    },
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "import": "./dist/index.mjs",
            "types": "./dist/index.d.ts"
        }
    },
    "devDependencies": {
        "@shared/eslint": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@types/node": "^22.2.0",
        "openapi-typescript": "^7.3.0",
        "openapi-typescript-codegen": "^0.29.0",
        "typescript": "latest"
    }
}

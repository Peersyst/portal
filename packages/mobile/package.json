{
    "name": "mobile-base-project",
    "private": true,
    "main": "node_modules/expo/AppEntry.js",
    "scripts": {
        "postinstall": "cd playground && yarn && cd ..",
        "start": "yarn generate && expo start",
        "start:fresh": "yarn start -c",
        "android": "yarn start --android",
        "android:fresh": "yarn start:fresh --android",
        "ios": "yarn start --ios",
        "ios:fresh": "yarn start:fresh --ios",
        "web": "yarn start --web",
        "web:fresh": "yarn start:fresh --web",
        "generate": "npm run generate:openapi && npm run generate:icons && npm run generate:images",
        "generate:icons": "node script/iconGeneratorNative.js ./src/ui/assets/icons/ ./src/ui/common/icons/ && prettier --write ./src/ui/common/icons/",
        "generate:images": "node script/imagesGenerator.js ./src/ui/assets/images/",
        "generate:openapi:services": "openapi -i ./openapi-spec.json -o src/data-access/api/service --exportSchemas=true --exportModels=false --useUnionTypes --postfix=Api",
        "generate:openapi:models": "openapi -i ./openapi-spec.json -o src/common/models/api --exportSchemas=false --useUnionTypes  --exportServices=false --exportCore=false",
        "generate:openapi": "yarn generate:openapi:services && yarn generate:openapi:models && node script/openapiPostScript.js",
        "eject": "expo eject",
        "test": "jest --maxWorkers=30%",
        "test:ui": "yarn test ./test/ui",
        "test:domain": "yarn test ./test/domain",
        "test:data-access": "yarn test ./test/data-access",
        "test:coverage": "yarn test --coverage",
        "test:coverage:ui": "yarn test:ui --coverage",
        "test:coverage:domain": "yarn test:domain --coverage",
        "test:coverage:data-access": "yarn test:data-access --coverage",
        "test:watch": "yarn test --watch",
        "test:watch:ui": "yarn test:ui --watch",
        "test:watch:domain": "yarn test:domain --watch",
        "test:watch:data-access": "yarn test:data-access --watch",
        "test:debug": "jest --no-cache --runInBand",
        "test:debug:ui": "jest ./test/ui --no-cache --runInBand",
        "test:debug:domain": "jest ./test/domain --no-cache --runInBand",
        "test:debug:data-access": "jest ./test/data-access --no-cache --runInBand",
        "test:ci": "jest --runInBand",
        "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.json --max-warnings 0",
        "playground:start": "yarn generate:icons && yarn --cwd ./playground start",
        "playground:android": "yarn playground:start --android",
        "playground:ios": "yarn playground:start --ios"
    },
    "dependencies": {
        "@peersyst/react-hooks": "^2.2.8",
        "@peersyst/react-native-components": "^3.0.0-alpha.0",
        "@peersyst/react-native-styled": "^3.0.0-alpha.0",
        "@peersyst/react-native-utils": "^2.0.0",
        "@peersyst/react-types": "^1.6.0",
        "@peersyst/react-utils": "^2.3.0",
        "@react-native-async-storage/async-storage": "1.17.11",
        "@react-native-community/hooks": "^3.0.0",
        "@react-navigation/native": "^6.1.6",
        "@react-navigation/native-stack": "^6.5.0",
        "@tanstack/react-query": "^4.28.0",
        "expo": "~48.0.8",
        "expo-asset": "~8.9.1",
        "expo-constants": "~14.2.1",
        "expo-font": "~11.1.1",
        "expo-linking": "~4.0.1",
        "expo-localization": "~14.1.1",
        "expo-secure-store": "~12.1.1",
        "expo-splash-screen": "~0.18.1",
        "expo-status-bar": "~1.4.4",
        "i18next": "^22.4.3",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-i18next": "^12.2.0",
        "react-native": "0.71.6",
        "react-native-gesture-handler": "~2.9.0",
        "react-native-keyboard-aware-scroll-view": "^0.9.5",
        "react-native-safe-area-context": "4.5.0",
        "react-native-screens": "~3.20.0",
        "react-native-svg": "13.4.0",
        "zustand": "^4.3.6"
    },
    "devDependencies": {
        "@babel/core": "^7.21.3",
        "@testing-library/jest-native": "^5.4.2",
        "@testing-library/react-native": "^12.0.0",
        "@types/jest": "^29.5.0",
        "@types/node": "^18.15.5",
        "@types/react": "~18.0.28",
        "@types/react-native": "~0.71.5",
        "@typescript-eslint/eslint-plugin": "^5.56.0",
        "@typescript-eslint/parser": "^5.56.0",
        "babel-plugin-module-resolver": "^5.0.0",
        "eslint": "^8.36.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-plugin-prettier": "^4.2.1",
        "eslint-plugin-react": "^7.32.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "jest": "^29.2.1",
        "jest-expo": "^48.0.2",
        "openapi-typescript": "^6.2.0",
        "openapi-typescript-codegen": "^0.23.0",
        "prettier": "^2.8.6",
        "react-test-renderer": "18.2.0",
        "ts-jest": "^29.0.5",
        "typescript": "~4.9.4"
    },
    "resolutions": {
        "react-native-safe-area-context": "4.5.0",
        "react-native-svg": "13.4.0",
        "expo-barcode-scanner": "^12.3.2"
    }
}

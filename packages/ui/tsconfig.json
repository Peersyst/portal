{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "target": "es2017",
        "sourceMap": true,
        "outDir": "./dist",
        "incremental": true,
        "skipLibCheck": true,
        "composite": true,
        "strict": true,
        "strictPropertyInitialization": false
    },
    "include": ["src/**/*", "test/**/*.ts"],
    "exclude": ["node_modules"]
}
